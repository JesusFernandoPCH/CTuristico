  "historia": [
    { "fecha": "finales de 1590", "hecho": "La Corona Española otorga las primeras Mercedes Reales para cultivar caña; origen de la hacienda." },
    { "fecha": "c. 1750", "hecho": "Supera las 4000 hectáreas y el casco queda consolidado: bóvedas de cañón, arcadas, cuarto de calderas, purgares, caballerizas, huerta y casa principal." },
    { "fecha": "1876-1911", "hecho": "En el Porfiriato pertenece a Ramón Portillo y Gómez, experto en técnicas de riego." },
    { "fecha": "1897", "hecho": "Primera hacienda en usar una turbina hidráulica con generador eléctrico, gracias a su acueducto. Pasa de producir azúcar a alcohol de caña." },
    { "fecha": "1910-1911", "hecho": "La Revolución paraliza la producción y sus tierras son expropiadas." },
    { "fecha": "11 de abril de 1911", "hecho": "El General Asunción pernocta aquí con más de 2000 hombres, un día antes de entregar las llaves de Cuernavaca a Emiliano Zapata." },
    { "fecha": "1950-1955", "hecho": "Tras ser molino de arroz se convierte en balneario. Se filman 'Los Gavilanes' (Pedro Infante, 1954) y 'El Ciclón' (Miguel Aceves Mejía)." },
    { "fecha": "hoy", "hecho": "Hotel Categoría Especial y escenario de programas de televisión, telenovelas y concursos de belleza." }
